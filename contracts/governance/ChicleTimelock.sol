pragma solidity ^0.8.37;

import {TimelockController} from "@openzeppelin/contracts/governance/TimelockController.sol";

/**
 * @title ChicleTimelock
 * @notice Controlador de Timelock para el ecosistema de gobernanza de Chicle.LOL.
 * @dev Garantiza un retardo mínimo (minDelay) entre la aprobación y la ejecución de propuestas.
 */
contract ChicleTimelock is TimelockController {
    /**
     * @param minDelay Tiempo mínimo en segundos que debe esperar una propuesta aprobada en cola antes de ejecutarse.
     * @param proposers Lista inicial de direcciones con rol PROPOSER_ROLE (generalmente el contrato Governor).
     * @param executors Lista inicial de direcciones con rol EXECUTOR_ROLE (address(0) permite a cualquiera ejecutar tras minDelay).
     * @param admin Dirección con TIMELOCK_ADMIN_ROLE para configuración inicial (debe renunciarse o transferirse al timelock).
     */
    constructor(
        uint256 minDelay,
        address[] memory proposers,
        address[] memory executors,
        address admin
    ) TimelockController(minDelay, proposers, executors, admin) {}
}
